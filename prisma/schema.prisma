// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  otp       Otp?
  tasks     Task[]
  projects  Project[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  email     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
}

// ─── OpenClaw Agents ───────────────────────────────────────────────────────────

model OpenClawAgent {
  id            String   @id @default(cuid())
  openclawId    String   @unique // e.g. "main", "journal"
  name          String
  workspace     String
  model         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cronJobs      CronJob[]
  recurringTasks RecurringTask[]
  journalEntries JournalEntry[]
}

// ─── OpenClaw Cron Jobs ────────────────────────────────────────────────────────

model CronJob {
  id           String   @id @default(cuid())
  openclawId   String   @unique // UUID from OpenClaw cron
  name         String
  description  String?
  schedule     String   // cron expression e.g. "0 21 * * *"
  timezone     String   @default("Asia/Calcutta")
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  enabled      Boolean  @default(true)
  openclawAgentId String
  openclawAgent   OpenClawAgent @relation(fields: [openclawAgentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── OpenClaw Recurring Tasks (from todo-registry.md) ─────────────────────────

model RecurringTask {
  id           String   @id @default(cuid())
  openclawId   String   @unique // stable ID from registry e.g. "plant-water"
  name         String
  logFile      String   // path relative to workspace e.g. "tasks/plant-watering-log.md"
  reminderTime String   // "21:00"
  notes        String?
  openclawAgentId String
  openclawAgent   OpenClawAgent @relation(fields: [openclawAgentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         RecurringTaskLog[]
}

model RecurringTaskLog {
  id       String   @id @default(cuid())
  taskId   String
  date     String   // "YYYY-MM-DD"
  status   String   // "done" | "missed" | "snoozed"
  note     String?
  loggedAt DateTime @default(now())
  task     RecurringTask @relation(fields: [taskId], references: [id])
  @@unique([taskId, date])
}

// ─── Journal Entries ─────────────────────────────────────────────────────────

model JournalEntry {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  rawEntries String?
  summary   String?
  openclawAgentId String?
  openclawAgent OpenClawAgent? @relation(fields: [openclawAgentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Health / Activity Logs ─────────────────────────────────────────────────

model HealthLog {
  id        String   @id @default(cuid())
  type      String   // "bottle" | "sleep" | "urine"
  timestamp DateTime
  value     String?  // ml for bottle, event for sleep
  note      String?
  createdAt DateTime @default(now())
  @@index([type, timestamp])
}

// ─── Task Board (Clawshboard native + OpenClaw-sourced) ─────────────────────

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("backlog")
  priority    String   @default("medium")
  source      String   @default("clawshboard") // "clawshboard" | "openclaw"
  openclawId  String?  // if sourced from OpenClaw
  assigneeId  String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  progress    Int      @default(0)
  source      String   @default("clawshboard")
  openclawId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  tasks       Task[]
}